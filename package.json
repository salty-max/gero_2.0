{
  "name": "gero",
  "packageManager": "bun@1.2.20",
  "private": false,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "turbo run start",
    "dev": "turbo run dev",
    "dev:lab": "turbo run dev --filter=gero-lab",
    "dev:gtx": "turbo run dev --filter=gtx-16",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@gero/*",
    "watch": "turbo run watch",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "bunx prettier . -w"
  },
  "devDependencies": {
    "turbo": "^2.0.6",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "bun-types": "^1.2.20",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1"
  },
  "peerDependencies": {},
  "dependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "tailwindcss": "^4.1.12"
  }
}
