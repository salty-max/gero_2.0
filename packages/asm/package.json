{
  "name": "@gero/asm",
  "version": "0.0.0",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/asm/src/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/asm/src/*/*.d.ts"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:esm": "bun build src/index.ts --outdir dist --sourcemap --minify --target=browser --format=esm",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run clean && bun run build:esm && bun run build:types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "format": "bunx prettier . -w",
    "watch:esm": "bun build src/index.ts --outdir dist --sourcemap --target=browser --format=esm --watch",
    "watch:types": "tsc -p tsconfig.build.json --watch",
    "watch": "rimraf dist && bun run watch:types & bun run watch:esm",
    "dev": "bun run watch"
  },
  "dependencies": {
    "@gero/vm": "workspace:*",
    "@gero/util": "workspace:*",
    "parsil": "^2.2.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  }
}
