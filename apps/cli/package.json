{
  "name": "gero-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/cli.ts examples/star.asm --dump",
    "build": "rimraf dist && bun build src/cli.ts --outdir dist --target=node --sourcemap --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "watch:esm": "bun build src/cli.ts --outdir dist --target=node --sourcemap --watch",
    "watch": "rimraf dist && bun run watch:esm",
    "dev": "bun run watch"
  },
  "dependencies": {
    "@gero/asm": "workspace:*",
    "@gero/vm": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
