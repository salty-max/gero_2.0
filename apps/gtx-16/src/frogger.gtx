--- CODE ---
const INPUT = $2620
const FROG = $2020

start:
  mov [$000e * $08], &[!FROG]
  mov [$000d * $08], &[!FROG + $02]
  mov $0002, r1
  lmov r1, &[!FROG + $04]

game_logic_loop:
check_up_pressed:
  mov8 &[!INPUT], acu
  jeq $00, &[!check_down_pressed]
  mov &[!FROG + $02], r1
  neg $04
  add acu, r1
  mov acu, &[!FROG + $02]

check_down_pressed:

check_left_pressed:

check_right_pressed:

end_of_game_logic:
  mov8 $01, &[!hasEnded]
end_of_game_logic_loop:
  mov !end_of_game_logic_loop , ip

after_frame:
  push acu
  mov8 &[!hasEnded], acu
  jeq $00, &[!after_frame2]
  mov8 $00, &[!hasEnded]
  pop acu
  pop r8
  push !game_logic_loop
  rti

after_frame2:
  pop acu
  rti

data8 hasEnded = { $00 }

